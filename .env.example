# TIMControl — variáveis de ambiente. Copie para .env (desenvolvimento) ou cadastre no EasyPanel (staging/produção).
# NUNCA commite valores reais. Passo a passo em docs/09-deploy.md.

# ---- Postgres ----
# Papel da APLICAÇÃO (sem BYPASSRLS): portal.
DATABASE_URL=postgres://timcontrol_app:timcontrol_app_dev@localhost:5441/timcontrol
# Papel de MIGRAÇÃO/dono: só migrate, seed e testes. Nunca na aplicação.
DATABASE_URL_ADMIN=postgres://timcontrol_owner:timcontrol_owner_dev@localhost:5441/timcontrol
# Opcionais do docker-compose.dev.yml (valem só na criação do volume)
# POSTGRES_PORT=5441
# APP_DB_PASSWORD=timcontrol_app_dev
# OWNER_DB_PASSWORD=timcontrol_owner_dev

# ---- Appwrite (instância que já roda na VPS, projeto "TIMControl") ----
# Endereço da API, ex.: https://appwrite.seudominio.com.br/v1
APPWRITE_ENDPOINT=
# Id do projeto TIMControl no console do Appwrite
APPWRITE_PROJECT_ID=
# Chave de API (SEGREDO). Escopos no Lote 1: users.read, users.write, sessions.write.
APPWRITE_API_KEY=

# ---- Portal ----
# Endereço público do portal, sem barra no fim; vai nos links dos e-mails (convite, senha).
# Precisa estar cadastrado como "plataforma web" no projeto do Appwrite.
APP_URL=http://localhost:3000
# Libera a tela /configuracao-inicial (criar o primeiro Gestor). 12+ caracteres. SEGREDO.
# Depois de criar o Gestor a tela se fecha sozinha; pode apagar a variável.
SETUP_CODE=
# Nome/versão mostrado em /api/health (ex.: v0.1.0). Mude a cada deploy marcado.
# APP_VERSION=
